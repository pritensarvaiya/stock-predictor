# Optional. When set, news summaries use Google Gemini.
# Leave blank to use the built-in VADER + finance-lexicon scorer.
GEMINI_API_KEY=

# Override the Gemini model id. Default is Gemini 3.1 Flash-Lite.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. When set, the UI and API require this password.
# Leave blank for open local use.
APP_PASSWORD=

# Container listen port. scripts/dev.sh ignores this and uses 8000 and 5173.
PORT=8000
